{
  "name": "cf-alc-recorder",
  "version": "1.0.0",
  "private": true,
  "description": "alc-app-s3 (M5Stack CoreS3 ハブ) の測定データを WebSocket で受けて rust-alc-api に記録する Worker (Durable Objects + Hibernatable WebSockets)。",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "tail": "wrangler tail"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.8.71",
    "@cloudflare/workers-types": "^4.20250101.0",
    "typescript": "^5.7.0",
    "vitest": "^3.2.4",
    "wrangler": "~4.35.0"
  }
}
